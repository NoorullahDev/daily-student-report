# Copy to .env.local for local dev. In Vercel, add the same keys under
# Project Settings -> Environment Variables (no .env file is deployed).
# Get the Supabase values from: Supabase Dashboard -> Project Settings -> API.

# Public Supabase project URL, e.g. https://xyzcompany.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# Public anon key (safe to expose in the browser; RLS limits what it can do)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service-role key — SECRET. Server-side admin API routes only. Never expose
# it in client code or commit it. (Supabase Dashboard -> API -> service_role)
SUPABASE_SERVICE_ROLE_KEY=

# Admin panel password (choose a strong one). Protects /admin.
ADMIN_PASSWORD=
# Optional: extra secret used to sign the admin session cookie.
# If left empty, ADMIN_PASSWORD itself is used as the signing secret.
ADMIN_SESSION_SECRET=
